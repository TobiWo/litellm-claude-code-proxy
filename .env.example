# GitHub Copilot authentication is OAuth-based (device flow).
# On first proxy start, LiteLLM prompts you to authenticate via GitHub.
# No API key env var is needed for Copilot — the token is stored locally.

LITELLM_PORT=4000
LITELLM_MASTER_KEY=sk-foo-bar-baz
LITELLM_LOCAL_MODEL_COST_MAP=true

UI_USERNAME=litellm
UI_PASSWORD=litellm

POSTGRES_USER=litellm
POSTGRES_PASSWORD=litellm
POSTGRES_DB=litellm
